# Backend configuration used by run-project.bat when copied into the root .env file.

# Server
SERVER_PORT=8080

# MySQL
DB_URL=jdbc:mysql://localhost:3306/gpsd_project?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC&autoReconnect=true
DB_USERNAME=root
DB_PASSWORD=

# Email delivery. Leave blank for development fallback logging.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@nvshop.lk

# Notify.lk SMS delivery. Leave SMS_API_KEY blank for simulated dev delivery.
SMS_USER_ID=
SMS_API_KEY=
SMS_SENDER_ID=NotifyDEMO
SMS_PROVIDER_URL=https://app.notify.lk/api/v1/send
